# pnpm omits devDependencies when NODE_ENV=production. Cejel declares
# `dependencies: {}` — every build and test tool is a devDependency — so a
# production-mode install installs nothing, exits 0, and prints
# "Already up to date". The failure surfaces much later as a missing binary,
# which reads as a toolchain problem rather than an install problem.
#
# Some Electron-hosted agent harnesses set NODE_ENV=production on the process
# that spawns their shells. A human's terminal can therefore install correctly
# while an automated lane silently installs nothing. Installation must not
# depend on that inherited value.
#
# The key is `production`, not `prod`. Setting `prod=false` has no effect on
# the NODE_ENV path even though `pnpm config get prod` then returns `false` —
# verified 2026-07-30, pnpm 9.0.0. Do not "simplify" this to `prod`.
production=false
