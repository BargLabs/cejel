{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cejel.dev/schemas/llm/discovery-anchor-contract-v2.json",
  "title": "Cejel resource-bounded detector-independent discovery contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "methodology_id",
    "status",
    "locked_at",
    "detector_results_seen_before_lock",
    "source_accessed_before_lock",
    "hash_contract",
    "search_families",
    "allowed_exclusion_codes",
    "resource_ceilings",
    "file_eligibility",
    "discovery_tool",
    "rules",
    "contract_sha256"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "2.0.0"},
    "protocol_id": {"const": "cejel-llm-calibration-v1"},
    "methodology_id": {
      "type": "string",
      "pattern": "^llm-opportunity-discovery-v[0-9]+(\\.[0-9]+)?$"
    },
    "status": {"const": "locked_before_source_access"},
    "locked_at": {"type": "string", "format": "date-time"},
    "detector_results_seen_before_lock": {"const": false},
    "source_accessed_before_lock": {"const": false},
    "hash_contract": {"const": "rfc8785-sha256-v1; contract excludes only contract_sha256"},
    "search_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_exclusion_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "resource_ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_eligible_files_per_repository",
        "maximum_hits_per_query",
        "maximum_candidates_per_repository_rule",
        "maximum_regex_scan_milliseconds_per_file"
      ],
      "properties": {
        "maximum_eligible_files_per_repository": {"type": "integer", "minimum": 1},
        "maximum_hits_per_query": {"type": "integer", "minimum": 1},
        "maximum_candidates_per_repository_rule": {"type": "integer", "minimum": 1},
        "maximum_regex_scan_milliseconds_per_file": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "file_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensions", "excluded_path_segments"],
      "properties": {
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9]+$"}
        },
        "excluded_path_segments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "not": {"pattern": "[\\\\/]"}}
        }
      }
    },
    "candidate_grouping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grouping_key", "minimum_distinct_query_recipes"],
      "properties": {
        "grouping_key": {"const": "cohort_repository_commit_rule_anchor"},
        "minimum_distinct_query_recipes": {"type": "integer", "minimum": 1}
      }
    },
    "discovery_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_sha256", "dependency_paths"],
      "properties": {
        "path": {"const": "calibration/llm/scripts/collect-discovery-hits-v2.mjs"},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "dependency_paths": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {"pattern": "(^|/)src/packs/llm(/|$)"}
          },
          "allOf": [
            {"contains": {"const": "node:crypto"}},
            {"contains": {"const": "node:fs"}},
            {"contains": {"const": "node:path"}},
            {"contains": {"const": "node:url"}},
            {"contains": {"const": "node:worker_threads"}},
            {"contains": {"const": "calibration/llm/scripts/freeze-cohorts.mjs"}}
          ]
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "anchor_kinds",
          "canonical_locus",
          "negative_boundary_policy",
          "candidate_normalization",
          "query_recipes"
        ],
        "properties": {
          "rule_id": {"type": "string", "minLength": 3},
          "anchor_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "canonical_locus": {"type": "string", "minLength": 20},
          "negative_boundary_policy": {"type": "string", "minLength": 20},
          "candidate_normalization": {"type": "string", "minLength": 20},
          "query_recipes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["query_id", "family", "semantic_cues", "query_patterns"],
              "properties": {
                "query_id": {"type": "string", "minLength": 3},
                "family": {"type": "string", "minLength": 1},
                "semantic_cues": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "query_patterns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["pattern_id", "regex", "flags", "anchor_kind"],
                    "properties": {
                      "pattern_id": {"type": "string", "minLength": 3},
                      "regex": {"type": "string", "minLength": 1},
                      "flags": {"type": "string", "pattern": "^[gimsuy]*$"},
                      "anchor_kind": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
