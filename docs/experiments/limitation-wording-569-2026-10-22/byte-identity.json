{
  "schema": "cejel-informal-byte-identity-v2",
  "preregistered": false,
  "change": "#569 (PR #571): the control-character history scan limitation calls a path credential-shaped only when its name is, under the rubric's own history grammar (or it is .env-shaped)",
  "baseScannerCommit": "c9d341d5f9dd577b44276e255f8657984fdce2bb",
  "candidateScannerCommit": "95024420683b025028dc478355a3cbf6496e329f",
  "rubrics": {
    "v17": "witan-rubric-v17-2026-07-24 (CLI default)",
    "v23": "witan-rubric-v23-prospective-2026-09-06",
    "v27": "witan-rubric-v27-prospective-2026-10-19"
  },
  "method": [
    "Each scan: node_modules/.bin/tsx src/index.ts scan <target> --out <dir> --quiet [--rubric-pin <rubric>], run from a clean tree at its scanner commit (base: a git archive of baseScannerCommit; candidate: the branch worktree at candidateScannerCommit), into a fresh output directory that did not exist before the scan (the script refuses an existing one); its exit code is recorded per row.",
    "report.json of each side is compared byte for byte, and its sha256 recorded here. Hashes alone do not show that a scan ran correctly: the same code run twice, a stale report or a wrong target would also give identical hashes. The exit codes, the two scanner commits and the target pins are recorded for that reason, and two independent grounds are given below.",
    "An earlier attempt of this measurement was broken because another agent overwrote a shared scratch script mid-session; it was redone with a private script and a fresh output root. Its results are not used here."
  ],
  "targets": "the 23 public rows of leaderboard/corpus.json (sha256 dc723f53a201542e0febb98964093ba4a3e7173221e746ba56aab6f726400d00): the full-history, unfiltered clones the 0.6.8 successor confirmation used, each at its corpus commit (targetCommit equals corpusCommit on every row), clean before and after",
  "independentGrounds": {
    "historyControlCharacterPaths": {
      "method": "git log --no-show-signature HEAD --name-only -z --format= --no-renames on each clone, split on NUL, every path tested for a byte in 0x00-0x1f or 0x7f",
      "rowsWithSuchPaths": {
        "axios": [
          "\bMIGRATION_GUIDE.md"
        ]
      },
      "note": "This walk omits merge diffs (no -m), so a path that appears only in a merge's own diff is not listed; #571 review pass 1 ran the walk with -m and also found such a path only in axios (https://github.com/BargLabs/cejel/pull/571#issuecomment-6348352322)."
    },
    "reviewerReproduction": "the #571 review passes reproduced the axios one-line difference and matched report hashes independently (pass 2 round 2: 28 of 28 hashes of the earlier record; pass 1: 24 hashes); see https://github.com/BargLabs/cejel/pull/571 comments 6348090617 and 6348113615"
  },
