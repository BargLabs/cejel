{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cejel.dev/schemas/ingest/v1.json",
  "title": "Cejel generic ingest contract v1",
  "description": "Versioned, offline external-signal input accepted by cejel --ingest.",
  "type": "object",
  "required": ["version", "tool", "signals"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Contract major and minor version. This schema covers additive 1.x versions."
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/signal" }
    },
    "subject": {
      "type": "object",
      "description": "Added in 1.1, optional. What the findings are about. Read only when version declares minor 1 or later.",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Repository identity, e.g. github.com/owner/repo or a clone URL."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$",
          "description": "Commit the producer read. A full id is compared exactly; a shorter one as a prefix."
        }
      },
      "additionalProperties": true
    },
    "producer": {
      "type": "object",
      "description": "Added in 1.1, optional. The tool build that produced the document; name defaults to tool.",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": true
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Added in 1.1, optional. When the producer observed the subject, RFC 3339 with an offset."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "signal": {
      "type": "object",
      "required": ["dimension", "findings"],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": ["A1", "A2", "A3", "A4", "A5", "B1", "B2", "B3", "B4", "B5", "B6"]
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/finding" }
        }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": ["ruleId", "severity", "message"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["critical", "warning", "info"] },
        "message": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
