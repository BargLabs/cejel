{
  "name": "@cejel/cejel",
  "version": "0.4.5",
  "mcpName": "io.github.BargLabs/cejel",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Offline trust certificate for your codebase — scores tests, secrets, isolation, claim-vs-reality, and CI discipline; especially useful for AI-written code. Supports JS/TS, Python, Go, Rust, Java, Ruby, PHP, C#, C/C++ and more — see README for the full language matrix.",
  "keywords": [
    "trust",
    "trust-certificate",
    "sarif",
    "code-quality",
    "security",
    "ai-generated-code",
    "code-review",
    "scorecard",
    "cli",
    "audit",
    "aggregator",
    "offline"
  ],
  "license": "AGPL-3.0-only",
  "author": "Barg Labs",
  "homepage": "https://cejel.dev",
  "bugs": {
    "url": "https://github.com/BargLabs/cejel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BargLabs/cejel.git"
  },
  "packageManager": "pnpm@9.0.0",
  "type": "module",
  "bin": {
    "cejel": "dist/index.js",
    "cejel-mcp": "dist/mcp/index.js"
  },
  "exports": {
    "./d-series": "./dist/packs/d-series/index.js",
    "./decision-contracts": "./dist/packs/decision-contracts/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "build:sea-js": "tsup --config tsup.public-sea.config.ts",
    "check:dev-environment": "node scripts/assert-dev-environment.mjs --phase=verify",
    "audit:path-emission": "node --test scripts/criterion-path-emission-audit.node-test.mjs",
    "gate:d1": "pnpm run build && node scripts/d1-precision-gate.mjs",
    "gate:d2": "pnpm run build && node scripts/d2-precision-gate.mjs",
    "gate:d3": "pnpm run build && node scripts/d3-precision-gate.mjs",
    "gate:d4": "pnpm run build && node scripts/d4-precision-gate.mjs",
    "gate:d5": "pnpm run build && node scripts/d5-precision-gate.mjs",
    "gate:d6": "pnpm run build && node scripts/d6-precision-gate.mjs",
    "validate:distribution": "node scripts/validate-distribution-metadata.mjs",
    "pnpm:devPreinstall": "node scripts/assert-dev-environment.mjs --phase=preinstall",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build",
    "pretest": "node scripts/assert-dev-environment.mjs --phase=verify",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^25.9.1",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.0"
  }
}
